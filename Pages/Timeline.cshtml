@page
@model WanderGlobe.Pages.TimelineModel
@{
    ViewData["Title"] = "La Tua Timeline di Viaggio";
}

<div class="universe-container">
    <!-- Stelle animate di sfondo -->
    <div id="stars-container"></div>

    <div class="timeline-container">
        <div class="timeline-header">
            <div class="timeline-title animated-element">
                <div class="title-icon-wrapper">
                    <i class="fas fa-route"></i>
                    <div class="pulse-effect"></div>
                </div>
                <div>
                    <h1>Il Tuo Viaggio nel Tempo</h1>
                    <p>Scopri la storia dei tuoi viaggi in ordine cronologico</p>
                </div>
            </div>

            <div class="timeline-controls animated-element">
                <div class="control-item dropdown">
                    <button class="btn btn-glass dropdown-toggle" type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-filter"></i> Filtra per
                    </button>
                    <ul class="dropdown-menu glass-menu dropdown-menu-end filter-menu" aria-labelledby="filterDropdown" data-bs-auto-close="true">
                        <li><a class="dropdown-item filter-option active" href="#" data-filter="all">
                            <i class="fas fa-globe-americas"></i> Tutte le destinazioni
                        </a></li>
                        <div class="dropdown-divider"></div>
                        @foreach (var continent in Model.Continents)
                        {
                            <li><a class="dropdown-item filter-option" href="#" data-filter="@continent.ToLowerInvariant().Replace(" ", "-").Replace("/", "-")">
                                <i class="@GetContinentIcon(continent)"></i> @continent
                            </a></li>
                        }
                    </ul>
                </div>

                <div class="control-item dropdown">
                    <button class="btn btn-glass dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-sort"></i> Ordinamento
                    </button>
                    <ul class="dropdown-menu glass-menu dropdown-menu-end sort-menu" aria-labelledby="sortDropdown" data-bs-auto-close="true">
                        <li><a class="dropdown-item sort-option active" href="#" data-sort="newest">
                            <i class="fas fa-arrow-down"></i> Più recenti prima
                        </a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="oldest">
                            <i class="fas fa-arrow-up"></i> Più vecchi prima
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>


        <!-- Anno tabs - con effetto parallasse -->
        <div class="timeline-year-tabs animated-element">
            <div id="floating-compass">
                <img src="/images/compass.svg" alt="Compass" onerror="this.src='/images/compass.png';">
            </div>
            <div class="timeline-scroller">
                @foreach (var year in Model.VisitYears.OrderByDescending(y => y))
                {
                    <a href="#year-@year" class="year-tab" data-year="@year">
                        <span class="year-text">@year</span>
                        <div class="year-glow"></div>
                    </a>
                }
            </div>
        </div>

        <!-- Timeline continua con tutti gli anni -->
        <div class="timeline-content">
            <!-- Aereo volante che segue lo scroll -->
            <div id="flying-plane">
                <i class="fas fa-plane"></i>
            </div>
            
            <!-- Path decorativo con mappa puntinata -->
            <div class="dotted-path-container">
                <div class="dotted-path"></div>
            </div>
            
            @if (!Model.GroupedVisits.Any())
            {
                <div class="empty-timeline animated-element">
                    <div class="empty-globe">
                        <div class="globe">
                            <div class="globe-sphere">
                                <div class="globe-worldmap"></div>
                                <div class="globe-outer-shadow"></div>
                                <div class="globe-inner-shadow"></div>
                            </div>
                            <div class="globe-stand"></div>
                        </div>
                        <div class="pin-container">
                            <div class="pin"></div>
                            <div class="pin-shadow"></div>
                        </div>
                    </div>
                    <h3>Nessun viaggio ancora!</h3>
                    <p>Inizia ad aggiungere le città che hai visitato per costruire la tua timeline di viaggio.</p>
                    <a href="/Globe?tab=add" class="btn btn-neo-primary">
                        <i class="fas fa-plus-circle me-2"></i> Aggiungi una città
                    </a>
                </div>
            }
            else
            {
                @foreach (var yearGroup in Model.GroupedVisits.OrderByDescending(g => g.Key))
                {
                    <div class="timeline-year animated-section" id="year-@yearGroup.Key">
                        <div class="year-marker">
                            <div class="year-line"></div>
                            <div class="year-bubble">
                                <span>@yearGroup.Key</span>
                                <div class="ring"></div>
                                <div class="ring-pulse"></div>
                            </div>
                        </div>
                        
                        <div class="timeline-events-wrapper">
                            <div class="timeline-events">
                                @foreach (var visit in yearGroup.Value.OrderByDescending(v => v.VisitDate))
                                {
                                    if (visit.Country != null)
                                    {
                                        var weatherData = Model.GetWeatherForCountry(visit.CountryId);
                                        var continentClass = visit.Country.Continent?.ToLowerInvariant().Replace(" ", "-").Replace("/", "-") ?? "unknown-continent";
                                        
                                        <div class="timeline-event @continentClass" data-continent="@continentClass">
                                            <div class="event-date">
                                                <span>@visit.VisitDate.Day @(new DateTime(yearGroup.Key, visit.VisitDate.Month, 1).ToString("MMMM", new System.Globalization.CultureInfo("it-IT")))</span>
                                            </div>
                                            
                                            <div class="event-card">
                                                <div class="card-glare"></div>
                                                <div class="event-image">
                                                    <div class="image-wrapper">
                                                        <img src="~/images/cities/@(visit.Country.Code.ToLower())-city.jpg" 
                                                            alt="@await Model.GetCapitalAsync(visit.Country.Code)" 
                                                            loading="lazy"
                                                            onerror="this.onerror=null; this.src='/images/default-city.jpg';">
                                                    </div>
                                                    <div class="country-flag">
                                                        <img src="~/images/flags/@(visit.Country.Code.ToLower()).png" 
                                                            alt="@visit.Country.Name" 
                                                            onerror="this.onerror=null; this.src='/images/flags/unknown.png';">
                                                    </div>
                                                    <div class="geo-tag">
                                                        <i class="fas fa-map-marker-alt"></i>
                                                    </div>
                                                </div>
                                                
                                                <div class="event-content">
                                                    <h3>@await Model.GetCapitalAsync(visit.Country.Code)</h3>
                                                    <div class="event-meta">
                                                        <span class="country-name">
                                                            <i class="fas fa-map"></i> @visit.Country.Name
                                                        </span>
                                                        <span class="continent-badge" data-continent="@continentClass">
                                                            <i class="@GetContinentIcon(visit.Country.Continent)"></i> @visit.Country.Continent
                                                        </span>
                                                    </div>
                                                    
                                                    <div class="event-details">
                                                        @if (weatherData != null)
                                                        {
                                                            <div class="weather-info">
                                                                <div class="weather-icon">
                                                                    @{
                                                                        string weatherIconClass = weatherData.Condition switch
                                                                        {
                                                                            "Soleggiato" => "fas fa-sun",
                                                                            "Sereno" => "fas fa-sun",
                                                                            "Poco nuvoloso" => "fas fa-cloud-sun",
                                                                            "Parzialmente nuvoloso" => "fas fa-cloud-sun",
                                                                            "Nuvoloso" => "fas fa-cloud",
                                                                            "Coperto" => "fas fa-cloud",
                                                                            "Piovoso" => "fas fa-cloud-rain",
                                                                            "Pioggia debole" => "fas fa-cloud-showers-heavy",
                                                                            "Pioggia moderata" => "fas fa-cloud-rain",
                                                                            "Pioggia forte" => "fas fa-pour-rain", // Custom or find appropriate
                                                                            "Pioviggine" => "fas fa-cloud-drizzle", // Custom or find appropriate
                                                                            "Temporale" => "fas fa-bolt",
                                                                            "Nevoso" => "fas fa-snowflake",
                                                                            "Neve debole" => "fas fa-snowflake",
                                                                            "Nebbioso" => "fas fa-smog",
                                                                            "Foschia" => "fas fa-smog",
                                                                            _ => "fas fa-question-circle" // Default for unknown
                                                                        };
                                                                    }
                                                                    <i class="@weatherIconClass"></i>
                                                                </div>
                                                                <div class="weather-details">
                                                                    <span class="temperature">@weatherData.Temperature°C</span>
                                                                    <span class="condition">@weatherData.Condition</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                    
                                                    <div class="event-actions">
                                                        <a href="/Globe?highlight=@visit.CountryId" class="btn btn-neo-primary hover-float">
                                                            <i class="fas fa-globe"></i>
                                                            <span>Visualizza sul globo</span>
                                                        </a>
                                                        <button type="button" class="btn btn-neo-secondary hover-float" data-bs-toggle="modal" data-bs-target="#visitModal@(visit.CountryId)">
                                                            <i class="fas fa-edit"></i>
                                                            <span>Modifica</span>
                                                        </button>
                                                        <button type="button" class="btn btn-circle memory-btn" title="Aggiungi ricordo">
                                                            <i class="fas fa-camera"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            
            <!-- Progress indicator animato -->
            <div class="journey-progress">
                <div class="journey-indicator">
                    <div class="compass-rose">
                        <div class="compass-face">
                            <div class="compass-needle"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal dialogs for editing visits -->
@foreach (var yearGroup in Model.GroupedVisits)
{
    @foreach (var visit in yearGroup.Value.Where(v => v.Country != null))
    {
        <div class="modal fade custom-modal" id="visitModal@(visit.CountryId)" tabindex="-1" aria-labelledby="visitModalLabel@(visit.CountryId)" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content glass-effect">
                    <div class="modal-header">
                        <h5 class="modal-title" id="visitModalLabel@(visit.CountryId)">Modifica Visita - @visit.Country.Name</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="city-info">
                            <div class="city-image">
                                <img src="/images/flags/@(visit.Country.Code.ToLower()).png" alt="@visit.Country.Name"
                                     onerror="this.onerror=null; this.src='/images/flags/unknown.png';">
                            </div>
                            <div class="city-details">
                                <h6>@await Model.GetCapitalAsync(visit.Country.Code)</h6>
                                <p>@visit.Country.Name</p>
                            </div>
                        </div>
                        <form method="post" asp-page-handler="EditVisit">
                            <input type="hidden" name="visitId" value="@visit.CountryId" /> @* Assuming CountryId is the VisitId for this context *@
                            <div class="mb-3">
                                <label for="visitDate@(visit.CountryId)" class="form-label">
                                    <i class="fas fa-calendar-alt me-2"></i> Data della visita
                                </label>
                                <div class="date-input-wrapper">
                                    <input type="date" class="form-control neo-input" id="visitDate@(visit.CountryId)" 
                                           name="visitDate" value="@visit.VisitDate.ToString("yyyy-MM-dd")" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="visitNotes@(visit.CountryId)" class="form-label">
                                    <i class="fas fa-comment-alt me-2"></i> Note sul viaggio
                                </label>
                                <textarea class="form-control neo-input" id="visitNotes@(visit.CountryId)" 
                                          name="visitNotes" rows="4">@visit.Notes</textarea>
                            </div>
                            <div class="memory-gallery">
                                <h6 class="gallery-title"><i class="fas fa-images me-2"></i> Ricordi</h6>
                                <div class="memory-photos">
                                    @* Photos would be loaded dynamically here, or if pre-loaded: *@
                                    @* @foreach(var photo in Model.GetPhotosForVisit(visit.CountryId)) { ... } *@
                                    <div class="add-photo" title="Aggiungi foto">
                                        <i class="fas fa-plus"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-link" data-bs-dismiss="modal">Annulla</button>
                                <button type="submit" class="btn btn-primary">Salva modifiche</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}

<!-- Gallery Modal -->
<div class="modal fade" id="galleryModal" tabindex="-1" aria-labelledby="galleryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="galleryModalLabel">Galleria Fotografica</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
      </div>
      <div class="modal-body p-0">
        <div id="galleryCarousel" class="carousel slide" data-bs-ride="false">
          <div class="carousel-inner">
            <!-- Photos will be loaded dynamically -->
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#galleryCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Precedente</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#galleryCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Successivo</span>
          </button>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
      </div>
    </div>
  </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css">
    <link rel="stylesheet" href="~/css/timeline.css" asp-append-version="true" />
    <style>
        /* Basic styles for highlight and empty message, assuming they might not be in timeline.css */
        .highlight-event .event-card {
            box-shadow: 0 0 15px 5px var(--neo-primary-glow, #00aaff);
            transform: scale(1.02);
            transition: transform 0.3s ease-out, box-shadow 0.3s ease-out;
        }
        .empty-year-message {
            padding: 20px;
            text-align: center;
            background-color: rgba(30, 30, 50, 0.7); /* Darker, semi-transparent background */
            border-radius: 8px;
            margin: 20px auto;
            color: #e0e0e0;
            border: 1px solid rgba(255, 255, 255, 0.2);
            max-width: 80%;
        }
        .animated-section, .animated-element {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }
        .animated-section.in-view, .animated-element.in-view {
            opacity: 1;
            transform: translateY(0);
        }
        .highlight-section {
            box-shadow: 0 0 10px 3px gold;
            border-radius: 5px;
            transition: box-shadow 0.5s ease-in-out;
        }
        .memory-photo {
            position: relative;
            /* other styles for photo preview */
        }
        .loading-overlay, .success-indicator {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba(0,0,0,0.5);
            color: white;
            font-size: 1.5rem;
        }
        .success-indicator {
            background-color: rgba(0,128,0,0.5);
            opacity: 1;
            transition: opacity 0.3s ease-out;
        }
        .photo-delete-btn {
            position: absolute;
            top: 5px;
            right: 5px;
            background-color: rgba(255,0,0,0.7);
            color: white;
            border: none;
            border-radius: 50%;
            width: 25px;
            height: 25px;
            font-size: 0.8rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .upload-error .loading-overlay {
             background-color: rgba(255,0,0,0.5);
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Inizializza AOS (Animate On Scroll)
            AOS.init({
                duration: 800,
                offset: 100,
                once: false, // Keep false for re-animation on scroll up/down if desired with mirror
                mirror: true, // Animates elements on scroll up as well
                easing: 'ease-out-cubic'
            });
            
            createStars();
            
            setTimeout(() => {
                const firstYearTab = document.querySelector('.year-tab');
                if (firstYearTab) {
                    firstYearTab.classList.add('active');
                    // scrollToYear(firstYearTab.getAttribute('data-year')); // Optional: initial scroll
                }
                // Initial call to animate sections already in view without scrolling
                animateSections(); 
            }, 500);
            
            document.querySelectorAll('.event-card').forEach(card => {
                card.addEventListener('mousemove', handleGlareEffect);
                card.addEventListener('mouseleave', function(e) {
                    const glare = this.querySelector('.card-glare');
                    if (glare) glare.style.opacity = "0";
                });
            });
            
            window.addEventListener('scroll', handleFlyingPlane);
            window.addEventListener('scroll', scrollSpyYearTabs); // For year tab activation
            
            document.querySelectorAll('.year-tab').forEach(tab => {
                tab.addEventListener('click', function(e) {
                    e.preventDefault();
                    document.querySelectorAll('.year-tab').forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    const year = this.getAttribute('data-year');
                    scrollToYear(year);
                });
            });
            
            document.querySelectorAll('.filter-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();
                    document.querySelectorAll('.filter-option').forEach(o => o.classList.remove('active'));
                    this.classList.add('active');
                    const filter = this.getAttribute('data-filter');
                    filterEvents(filter);
                    const dropdownButton = document.getElementById('filterDropdown');
                    if (dropdownButton) {
                        const iconHtml = this.querySelector('i')?.outerHTML || '';
                        dropdownButton.innerHTML = `${iconHtml} ${this.textContent.trim()}`;
                    }
                });
            });
            
            // Dropdown positioning (Bootstrap 5 usually handles this well, but keep if specific adjustments are needed)
            document.querySelectorAll('.dropdown').forEach(dropdown => {
                const button = dropdown.querySelector('.dropdown-toggle');
                const menu = dropdown.querySelector('.dropdown-menu');
                if (button && menu) {
                    // Using Bootstrap's events for better reliability
                    dropdown.addEventListener('shown.bs.dropdown', function () {
                        // Popper.js (used by Bootstrap) should handle positioning.
                        // Manual adjustments can be done here if Popper's auto-placement isn't perfect.
                        // Example: menu.style.zIndex = '1100'; // If z-index is an issue
                    });
                }
            });

            document.querySelectorAll('.sort-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();
                    document.querySelectorAll('.sort-option').forEach(o => o.classList.remove('active'));
                    this.classList.add('active');
                    const sort = this.getAttribute('data-sort');
                    sortEvents(sort);
                    const dropdownButton = document.getElementById('sortDropdown');
                    if (dropdownButton) {
                         const iconHtml = this.querySelector('i')?.outerHTML || '';
                        dropdownButton.innerHTML = `${iconHtml} ${this.textContent.trim()}`;
                    }
                });
            });
            
            const progressIndicator = document.querySelector('.journey-indicator');
            if (progressIndicator) {
                progressIndicator.addEventListener('click', function() {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }
            
            highlightFromUrl();

            // Camera button functionality
            document.querySelectorAll('.memory-btn').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const eventCard = this.closest('.timeline-event');
                    if (!eventCard) return;
                    const editButton = eventCard.querySelector('button[data-bs-target]');
                    if (!editButton) return;
                    const modalId = editButton.getAttribute('data-bs-target');
                    // const countryId = modalId.replace('#visitModal', ''); // This gets the country ID part
                    const visitModalElement = document.querySelector(modalId); // Get the modal element itself
                    if (visitModalElement) {
                        const visitModal = new bootstrap.Modal(visitModalElement);
                        visitModal.show();
                        setTimeout(() => {
                            const photoSection = visitModalElement.querySelector('.memory-gallery');
                            if (photoSection) {
                                photoSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                photoSection.classList.add('highlight-section');
                                setTimeout(() => {
                                    photoSection.classList.remove('highlight-section');
                                }, 2000);
                            }
                        }, 300); // Wait for modal to be shown
                    }
                });
            });

            // Add photo functionality in modals
            document.querySelectorAll('.add-photo').forEach(addPhotoBtn => {
                addPhotoBtn.addEventListener('click', function() {
                    const fileInput = document.createElement('input');
                    fileInput.type = 'file';
                    fileInput.accept = 'image/*';
                    fileInput.style.display = 'none';
                    document.body.appendChild(fileInput);
                    fileInput.click();
                    
                    fileInput.addEventListener('change', function() {
                        if (this.files && this.files[0]) {
                            const file = this.files[0];
                            const modal = addPhotoBtn.closest('.modal');
                            const visitIdInput = modal.querySelector('input[name="visitId"]');
                            if (!visitIdInput) {
                                console.error('Visit ID input not found in modal.');
                                document.body.removeChild(fileInput);
                                return;
                            }
                            const visitId = visitIdInput.value;
                            
                            const formData = new FormData();
                            formData.append('photo', file);
                            formData.append('countryId', visitId); // Assuming 'visitId' hidden input holds CountryId
                            
                            const photoPreview = document.createElement('div');
                            photoPreview.className = 'memory-photo';
                            
                            const img = document.createElement('img');
                            const reader = new FileReader();
                            reader.onload = function(e) { img.src = e.target.result; };
                            reader.readAsDataURL(file);
                            photoPreview.appendChild(img);
                            
                            const loadingOverlay = document.createElement('div');
                            loadingOverlay.className = 'loading-overlay';
                            loadingOverlay.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>';
                            photoPreview.appendChild(loadingOverlay);
                            
                            const memoryPhotosContainer = addPhotoBtn.closest('.memory-photos');
                            memoryPhotosContainer.insertBefore(photoPreview, addPhotoBtn);
                            
                            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]');

                            fetch('?handler=UploadPhoto', {
                                method: 'POST',
                                body: formData,
                                headers: {
                                    'RequestVerificationToken': csrfToken ? csrfToken.value : ''
                                }
                            })
                            .then(response => {
                                if (response.ok) return response.json();
                                return response.text().then(text => { throw new Error('Upload failed: ' + text) });
                            })
                            .then(data => {
                                loadingOverlay.remove();
                                if (data.success && data.photoId && data.photoUrl) {
                                    img.src = data.photoUrl; // Update with server URL if different
                                    const successIndicator = document.createElement('div');
                                    successIndicator.className = 'success-indicator';
                                    successIndicator.innerHTML = '<i class="fas fa-check"></i>';
                                    photoPreview.appendChild(successIndicator);
                                    
                                    const deleteBtn = document.createElement('button');
                                    deleteBtn.type = 'button';
                                    deleteBtn.className = 'photo-delete-btn';
                                    deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
                                    deleteBtn.title = 'Elimina foto';
                                    deleteBtn.setAttribute('data-photo-id', data.photoId);
                                    photoPreview.appendChild(deleteBtn);
                                    
                                    deleteBtn.addEventListener('click', function() {
                                        deletePhoto(data.photoId, photoPreview);
                                    });
                                    
                                    photoPreview.setAttribute('data-photo-id', data.photoId);
                                    img.addEventListener('click', function(e) {
                                        if (e.target !== deleteBtn && !deleteBtn.contains(e.target)) {
                                            openPhotoGallery(visitId, data.photoId);
                                        }
                                    });
                                    
                                    setTimeout(() => {
                                        successIndicator.style.opacity = '0';
                                        setTimeout(() => { successIndicator.remove(); }, 300);
                                    }, 2000);
                                } else {
                                    throw new Error(data.message || "Upload failed, no specific error.");
                                }
                            })
                            .catch(error => {
                                console.error('Error uploading photo:', error);
                                photoPreview.classList.add('upload-error');
                                loadingOverlay.innerHTML = `<i class="fas fa-exclamation-triangle" title="${error.message}"></i>`;
                                setTimeout(() => { photoPreview.remove(); }, 5000);
                            })
                            .finally(() => {
                                document.body.removeChild(fileInput);
                            });
                        } else {
                            document.body.removeChild(fileInput);
                        }
                    });
                     // In case user cancels file dialog
                    fileInput.oncancel = () => {
                        if (fileInput.parentNode) {
                           document.body.removeChild(fileInput);
                        }
                    };
                });
            });
        }); // End of outer DOMContentLoaded
        
        // ===== FUNZIONI HELPER =====
        
        function createStars() {
            const starsContainer = document.getElementById('stars-container');
            if (!starsContainer) return;
            starsContainer.innerHTML = ''; // Clear existing stars if any
            const starsCount = Math.floor(window.innerWidth / 15); // Adjusted count
            
            for (let i = 0; i < starsCount; i++) {
                const star = document.createElement('div');
                star.className = 'star';
                const x = Math.random() * 100;
                const y = Math.random() * 100;
                star.style.left = x + '%';
                star.style.top = y + '%';
                const size = Math.random() * 2.5 + 0.5; // Min size 0.5px
                star.style.width = size + 'px';
                star.style.height = size + 'px';
                const opacity = Math.random() * 0.7 + 0.1; // Min opacity 0.1
                star.style.opacity = opacity;
                const delay = Math.random() * 5; // Increased delay range
                star.style.animationDelay = delay + 's';
                star.style.animationDuration = (Math.random() * 5 + 3) + 's'; // Varied duration
                starsContainer.appendChild(star);
            }
        }

        function deletePhoto(photoId, elementToRemove) {
            if (!confirm('Sei sicuro di voler eliminare questa foto?')) return;
            
            const formData = new FormData();
            formData.append('photoId', photoId);
            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]');
            
            fetch('?handler=DeletePhoto', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': csrfToken ? csrfToken.value : ''
                }
            })
            .then(response => {
                if (response.ok) return response.json();
                return response.text().then(text => { throw new Error('Delete failed: ' + text) });
            })
            .then(data => {
                if (data.success) {
                    elementToRemove.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
                    elementToRemove.style.transform = 'scale(0)';
                    elementToRemove.style.opacity = '0';
                    setTimeout(() => {
                        elementToRemove.remove();
                    }, 300);
                } else {
                    alert('Errore durante l\'eliminazione della foto: ' + (data.message || 'Errore sconosciuto'));
                }
            })
            .catch(error => {
                console.error('Error deleting photo:', error);
                alert('Errore durante l\'eliminazione della foto. ' + error.message);
            });
        }
        
        function openPhotoGallery(visitId, activePhotoId = null) {
            fetch(`?handler=VisitPhotos&countryId=${visitId}`) // Assuming countryId is the visitId
            .then(response => response.json())
            .then(photos => {
                const galleryModalElement = document.getElementById('galleryModal');
                if (!galleryModalElement) return;
                const carouselInner = galleryModalElement.querySelector('.carousel-inner');
                carouselInner.innerHTML = '';
                
                if (!photos || photos.length === 0) {
                    carouselInner.innerHTML = '<p class="text-center p-3">Nessuna foto disponibile per questa visita.</p>';
                } else {
                    photos.forEach((photo, index) => {
                        const isActive = activePhotoId ? (photo.id.toString() === activePhotoId.toString()) : (index === 0);
                        const item = document.createElement('div');
                        item.className = `carousel-item ${isActive ? 'active' : ''}`;
                        item.innerHTML = `
                            <img src="${photo.url}" class="d-block w-100" alt="${photo.caption || 'Immagine del viaggio'}" style="max-height: 80vh; object-fit: contain;">
                            ${photo.caption ? `<div class="carousel-caption d-none d-md-block"><h5>${photo.caption}</h5></div>` : ''}
                        `;
                        carouselInner.appendChild(item);
                    });
                }
                const bsGalleryModal = new bootstrap.Modal(galleryModalElement);
                bsGalleryModal.show();
            })
            .catch(error => {
                console.error('Error fetching photos:', error);
                alert('Errore nel caricamento delle foto per la galleria.');
            });
        }
        
        function handleGlareEffect(e) {
            const card = this;
            const glare = card.querySelector('.card-glare');
            if (!glare) return;
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const mouseX = (x / rect.width) * 100;
            const mouseY = (y / rect.height) * 100;
            glare.style.setProperty('--mouse-x', mouseX + '%');
            glare.style.setProperty('--mouse-y', mouseY + '%');
            glare.style.opacity = "1";
        }
        
        let lastScrollPosition = 0;
        function handleFlyingPlane() {
            const plane = document.getElementById('flying-plane');
            if (!plane) return;
            const scrollY = window.scrollY || window.pageYOffset;
            const mainTimelineContent = document.querySelector('.timeline-content');
            if (!mainTimelineContent) return;

            // Calculate scroll percentage relative to the timeline-content height
            const timelineRect = mainTimelineContent.getBoundingClientRect();
            const timelineHeight = timelineRect.height - window.innerHeight;
            const scrollRelativeToTimeline = Math.max(0, -timelineRect.top);
            
            let scrollPercentage = 0;
            if (timelineHeight > 0) {
                 scrollPercentage = (scrollRelativeToTimeline / timelineHeight) * 100;
            }


            const planeMinY = 5; // 5% from top
            const planeMaxY = 90; // 90% from top (leaves 10% at bottom)
            let planeY = planeMinY + (scrollPercentage * (planeMaxY - planeMinY) / 100);
            planeY = Math.min(Math.max(planeY, planeMinY), planeMaxY);
            
            plane.style.top = planeY + '%';
            
            const oscillation = Math.sin(scrollY * 0.005) * 8; // Reduced oscillation
            plane.style.transform = `translateX(${oscillation}px) rotate(${oscillation/2}deg)`; // Added slight rotation
            
            if (scrollY > lastScrollPosition) { // Scrolling down
                plane.style.transform += ' rotate(2deg)';
            } else { // Scrolling up
                 plane.style.transform += ' rotate(-2deg)';
            }

            // Debounce turbulence animation
            if (!plane.classList.contains('turbulent')) {
                if (Math.abs(scrollY - lastScrollPosition) > 30) { // Only if scrolled a bit
                    plane.classList.add('turbulent');
                     setTimeout(() => {
                        plane.classList.remove('turbulent');
                    }, 300); // Duration of turbulence
                }
            }
            lastScrollPosition = scrollY;
        }
        
        function scrollToYear(year) {
            const yearSection = document.getElementById(`year-${year}`);
            if (yearSection) {
                const headerOffset = 120; // Adjust this value based on your fixed header/tabs height
                const elementPosition = yearSection.getBoundingClientRect().top;
                const offsetPosition = window.pageYOffset + elementPosition - headerOffset;
        
                window.scrollTo({
                    top: offsetPosition,
                    behavior: 'smooth'
                });
            }
        }
        
        function filterEvents(filter) {
            const timelineYears = document.querySelectorAll('.timeline-year');
            let anyEventVisibleOverall = false;

            timelineYears.forEach(yearElement => {
                const events = yearElement.querySelectorAll('.timeline-event');
                let anyEventVisibleInYear = false;
                events.forEach(event => {
                    // Check class list for continent or data-attribute
                    const continentClass = event.dataset.continent; // e.g., "europa", "asia"
                    if (filter === 'all' || continentClass === filter) {
                        event.style.opacity = '0'; // Start transparent for fade-in
                        event.style.display = 'block'; // Or 'flex', 'grid' if that's the original display
                        setTimeout(() => { event.style.opacity = '1'; }, 50); // Quick fade-in
                        anyEventVisibleInYear = true;
                        anyEventVisibleOverall = true;
                    } else {
                        event.style.opacity = '0';
                        setTimeout(() => { event.style.display = 'none'; }, 300);
                    }
                });

                let emptyMessage = yearElement.querySelector('.empty-year-message');
                if (!anyEventVisibleInYear && filter !== 'all') {
                    if (!emptyMessage) {
                        emptyMessage = document.createElement('div');
                        emptyMessage.className = 'empty-year-message';
                        emptyMessage.innerHTML = '<p>Nessun viaggio in questo anno con i filtri applicati.</p>';
                        // Insert after year-marker or at the start of timeline-events-wrapper
                        const eventsWrapper = yearElement.querySelector('.timeline-events-wrapper');
                        if(eventsWrapper) eventsWrapper.appendChild(emptyMessage);
                    }
                     emptyMessage.style.display = 'block';
                } else {
                    if (emptyMessage) {
                        emptyMessage.style.display = 'none'; // Hide instead of remove for quicker toggle
                    }
                }
            });
             setTimeout(() => { AOS.refresh(); }, 350); // Refresh AOS after DOM changes and animations
        }
        
        function sortEvents(sortOrder) {
            const timelineContent = document.querySelector('.timeline-content');
            if (!timelineContent) return;

            const yearSections = Array.from(timelineContent.querySelectorAll('.timeline-year'));
            
            // Preserve and detach special elements that should not be sorted with years
            const flyingPlane = document.getElementById('flying-plane');
            const dottedPathContainer = document.querySelector('.dotted-path-container');
            const journeyProgress = document.querySelector('.journey-progress');

            if (flyingPlane && flyingPlane.parentNode === timelineContent) timelineContent.removeChild(flyingPlane);
            if (dottedPathContainer && dottedPathContainer.parentNode === timelineContent) timelineContent.removeChild(dottedPathContainer);
            if (journeyProgress && journeyProgress.parentNode === timelineContent) timelineContent.removeChild(journeyProgress);


            yearSections.sort((a, b) => {
                const yearA = parseInt(a.id.replace('year-', ''));
                const yearB = parseInt(b.id.replace('year-', ''));
                return sortOrder === 'newest' ? yearB - yearA : yearA - yearB;
            });
            
            // Clear existing year sections before re-adding
            yearSections.forEach(section => {
                if (section.parentNode === timelineContent) timelineContent.removeChild(section);
            });
            
            // Re-add sorted year sections
            yearSections.forEach(section => timelineContent.appendChild(section));

            // Re-attach special elements in their logical order
            if (flyingPlane) timelineContent.insertBefore(flyingPlane, timelineContent.firstChild);
            if (dottedPathContainer) timelineContent.insertBefore(dottedPathContainer, flyingPlane ? flyingPlane.nextSibling : timelineContent.firstChild);
            if (journeyProgress) timelineContent.appendChild(journeyProgress); // Typically at the end or after all year sections

            // Note: Sorting events *within* each year by date (oldest/newest) would require more complex logic here
            // if the initial server-side order isn't already correct or if visit.VisitDate isn't easily accessible
            // as a sortable attribute on the .timeline-event elements.
            // For now, this function primarily sorts the year blocks.

            setTimeout(() => { AOS.refresh(); }, 500);
        }
        
        function animateSections() {
            const sections = document.querySelectorAll('.animated-section, .animated-element');
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                        obs.unobserve(entry.target); // Unobserve after animation
                    }
                });
            }, { threshold: 0.15 }); // Trigger a bit earlier
            
            sections.forEach(section => {
                observer.observe(section);
            });
        }
        
        function highlightFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            const highlightId = urlParams.get('highlight'); // This should be CountryId
            
            if (highlightId) {
                // Find the edit button that targets the modal for this CountryId, then get its parent .timeline-event
                const editButton = document.querySelector(`button[data-bs-target="#visitModal${highlightId}"]`);
                const eventToHighlight = editButton ? editButton.closest('.timeline-event') : null;
                
                if (eventToHighlight) {
                    setTimeout(() => { // Delay to ensure page is rendered
                        eventToHighlight.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        eventToHighlight.classList.add('highlight-event');
                        
                        const yearSection = eventToHighlight.closest('.timeline-year');
                        if (yearSection) {
                            const year = yearSection.id.replace('year-', '');
                            document.querySelectorAll('.year-tab').forEach(t => t.classList.remove('active'));
                            const activeTab = document.querySelector(`.year-tab[data-year="${year}"]`);
                            if (activeTab) activeTab.classList.add('active');
                        }

                        setTimeout(() => {
                            eventToHighlight.classList.remove('highlight-event');
                        }, 3000);
                    }, 700); 
                }
            }
        }

        function scrollSpyYearTabs() {
            const yearSections = document.querySelectorAll('.timeline-year');
            const yearTabs = document.querySelectorAll('.year-tab');
            const offset = window.innerHeight * 0.4; // Point in viewport to consider "active"

            let currentYearId = null;

            yearSections.forEach(section => {
                const rect = section.getBoundingClientRect();
                if (rect.top <= offset && rect.bottom >= offset) {
                    currentYearId = section.getAttribute('id');
                }
            });

            yearTabs.forEach(tab => {
                if (tab.getAttribute('href') === `#${currentYearId}`) {
                    if(!tab.classList.contains('active')) {
                       tab.classList.add('active');
                       // Optional: Scroll tab into view if scroller is overflowed
                       const scroller = document.querySelector('.timeline-scroller');
                       if (scroller && scroller.scrollWidth > scroller.clientWidth) {
                           scroller.scrollTo({
                               left: tab.offsetLeft - scroller.offsetWidth / 2 + tab.offsetWidth / 2,
                               behavior: 'smooth'
                           });
                       }
                    }
                } else {
                    tab.classList.remove('active');
                }
            });
        }

    </script>
}

@functions {
    string GetContinentIcon(string continent) {
        if (string.IsNullOrEmpty(continent)) return "fas fa-globe"; // Default icon
        
        switch (continent.Trim().ToLowerInvariant()) {
            case "europa": return "fas fa-landmark"; // Europe (landmark as generic representation)
            case "asia": return "fas fa-torii-gate"; // Asia (Torii gate or fas fa-pagoda or fas fa-dragon)
            case "africa": return "fas fa-mountain-sun"; // Africa (e.g., Kilimanjaro, or fas fa-hippo, fas fa-tree)
            case "nord america": case "north america": return "fas fa-monument"; // North America (e.g., Statue of Liberty, or fas fa-maple-leaf for Canada)
            case "sud america": case "south america": return "fas fa-tree-palm"; // South America (Palm tree for tropical vibe, or fas fa-mountain)
            case "oceania": return "fas fa-water"; // Oceania (Water, or fas fa-kiwi-bird for NZ, fas fa-australia for AU - custom needed)
            case "antartide": case "antarctica": return "fas fa-snowflake"; // Antarctica
            default: return "fas fa-globe"; // Fallback for any other unmapped continent
        }
    }
}