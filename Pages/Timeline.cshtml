@page
@model WanderGlobe.Pages.TimelineModel
@{
    ViewData["Title"] = "La Tua Timeline di Viaggio";
}

<div class="universe-container">
    <!-- Stelle animate di sfondo -->
    <div id="stars-container"></div>

    <div class="timeline-container">
        <div class="timeline-header">
            <div class="timeline-title animated-element">
                <div class="title-icon-wrapper">
                    <i class="fas fa-route"></i>
                    <div class="pulse-effect"></div>
                </div>
                <div>
                    <h1>Il Tuo Viaggio nel Tempo</h1>
                    <p>Scopri la storia dei tuoi viaggi in ordine cronologico</p>
                </div>
            </div>

            <div class="timeline-controls animated-element">
                <div class="control-item dropdown">
                    <button class="btn btn-glass dropdown-toggle" type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-filter"></i> Filtra per
                    </button>
                    <ul class="dropdown-menu glass-menu dropdown-menu-end filter-menu" aria-labelledby="filterDropdown" data-bs-auto-close="true">
                        <li><a class="dropdown-item filter-option active" href="#" data-filter="all">
                            <i class="fas fa-globe-americas"></i> Tutte le destinazioni
                        </a></li>
                        <div class="dropdown-divider"></div>
                        @* Assuming Model.Continents will be populated from VisitedCityViewModel.Continent distinct values *@
                        @foreach (var continent in Model.Continents.OrderBy(c => c))
                        {
                            <li><a class="dropdown-item filter-option" href="#" data-filter="@continent.ToLowerInvariant().Replace(" ", "-").Replace("/", "-")">
                                <i class="@GetContinentIcon(continent)"></i> @continent
                            </a></li>
                        }
                    </ul>
                </div>

                <div class="control-item dropdown">
                    <button class="btn btn-glass dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-sort"></i> Ordinamento
                    </button>
                    <ul class="dropdown-menu glass-menu dropdown-menu-end sort-menu" aria-labelledby="sortDropdown" data-bs-auto-close="true">
                        <li><a class="dropdown-item sort-option active" href="#" data-sort="newest">
                            <i class="fas fa-arrow-down"></i> Più recenti prima
                        </a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="oldest">
                            <i class="fas fa-arrow-up"></i> Più vecchi prima
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>


        <!-- Anno tabs - con effetto parallasse -->
        <div class="timeline-year-tabs animated-element">
            <div id="floating-compass">
                <img src="/images/compass.svg" alt="Compass" onerror="this.src='/images/compass.png';">
            </div>
            <div class="timeline-scroller">
                @* Assuming Model.VisitYears will be populated from distinct years of VisitedCityViewModel.VisitDate *@
                @foreach (var year in Model.VisitYears.OrderByDescending(y => y))
                {
                    <a href="#year-@year" class="year-tab" data-year="@year">
                        <span class="year-text">@year</span>
                        <div class="year-glow"></div>
                    </a>
                }
            </div>
        </div>

        <!-- Timeline continua con tutti gli anni -->
        <div class="timeline-content">
            <!-- Aereo volante che segue lo scroll -->
            <div id="flying-plane">
                <i class="fas fa-plane"></i>
            </div>
            
            <!-- Path decorativo con mappa puntinata -->
            <div class="dotted-path-container">
                <div class="dotted-path"></div>
            </div>
            
            @if (!Model.GroupedVisits.Any())
            {
                <div class="empty-timeline animated-element">
                    <div class="empty-globe">
                        <div class="globe">
                            <div class="globe-sphere">
                                <div class="globe-worldmap"></div>
                                <div class="globe-outer-shadow"></div>
                                <div class="globe-inner-shadow"></div>
                            </div>
                            <div class="globe-stand"></div>
                        </div>
                        <div class="pin-container">
                            <div class="pin"></div>
                            <div class="pin-shadow"></div>
                        </div>
                    </div>
                    <h3>Nessun viaggio ancora!</h3>
                    <p>Inizia ad aggiungere le città che hai visitato per costruire la tua timeline di viaggio.</p>
                    <a href="/Globe#add" class="btn btn-neo-primary"> @* Updated link to Globe add tab *@
                        <i class="fas fa-plus-circle me-2"></i> Aggiungi una città
                    </a>
                </div>
            }
            else
            {
                @foreach (var yearGroup in Model.GroupedVisits.OrderByDescending(g => g.Key))
                {
                    <div class="timeline-year animated-section" id="year-@yearGroup.Key">
                        <div class="year-marker">
                            <div class="year-line"></div>
                            <div class="year-bubble">
                                <span>@yearGroup.Key</span>
                                <div class="ring"></div>
                                <div class="ring-pulse"></div>
                            </div>
                        </div>
                        
                        <div class="timeline-events-wrapper">
                            <div class="timeline-events">
                                @* Each 'visit' is now a VisitedCityViewModel *@
                                @foreach (var visit in yearGroup.Value) @* Assuming already ordered in OnGetAsync in TimelineModel.cs *@
                                {
                                    // The 'visit' object now directly contains city and country info
                                    if (!string.IsNullOrEmpty(visit.CityName) && !string.IsNullOrEmpty(visit.CountryName))
                                    {
                                        var weatherData = Model.GetWeatherForCityVisit(visit.CityId, visit.VisitDate); // Assumes this method exists in Model
                                        var continentClass = visit.Continent?.ToLowerInvariant().Replace(" ", "-").Replace("/", "-") ?? "unknown-continent";
                                        var modalIdSuffix = $"{visit.VisitedCityRecordId}"; // Use the unique PK of the VisitedCity record
                                        
                                        <div class="timeline-event @continentClass" data-continent="@continentClass" data-cityid="@visit.CityId" data-visit-id="@visit.VisitedCityRecordId">
                                            <div class="event-date">
                                                <span>@visit.VisitDate.Day @(new DateTime(yearGroup.Key, visit.VisitDate.Month, 1).ToString("MMMM", new System.Globalization.CultureInfo("it-IT")))</span>
                                            </div>
                                            
                                            <div class="event-card">
                                                <div class="card-glare"></div>
                                                <div class="event-image">
                                                    <div class="image-wrapper">
                                                        @* 
                                                            Image source:
                                                            - Uses visit.CitySpecificImage if available (e.g., "barcelona.jpg")
                                                            - Falls back to country-based image (e.g., "es-city.jpg" for Madrid)
                                                            - Final fallback to default-city.jpg
                                                            You need to ensure visit.CitySpecificImage property is populated in VisitedCityViewModel if you want unique city images.
                                                        *@
                                                        <img src="@(string.IsNullOrEmpty(visit.CitySpecificImage) ? $"~/images/cities/{visit.CountryCode?.ToLower()}-city.jpg" : $"~/images/cities/{visit.CitySpecificImage}")" 
                                                             alt="@visit.CityName" 
                                                             loading="lazy"
                                                             onerror="this.onerror=null; this.src='/images/default-city.jpg';">
                                                    </div>
                                                    <div class="country-flag">
                                                        <img src="~/images/flags/@(visit.CountryCode?.ToLower()).png" 
                                                             alt="@visit.CountryName" 
                                                             onerror="this.onerror=null; this.src='/images/flags/unknown.png';">
                                                    </div>
                                                    <div class="geo-tag">
                                                        <i class="fas fa-map-marker-alt"></i>
                                                    </div>
                                                </div>
                                                
                                                <div class="event-content">
                                                    <h3>@visit.CityName</h3>
                                                    <div class="event-meta">
                                                        <span class="country-name">
                                                            <i class="fas fa-map"></i> @visit.CountryName
                                                        </span>
                                                        @if(!string.IsNullOrEmpty(visit.Continent))
                                                        {
                                                        <span class="continent-badge" data-continent="@continentClass">
                                                            <i class="@GetContinentIcon(visit.Continent)"></i> @visit.Continent
                                                        </span>
                                                        }
                                                    </div>
                                                    
                                                    <div class="event-details">
                                                        @if (weatherData != null && weatherData.Condition != "N/D")
                                                        {
                                                            <div class="weather-info">
                                                                <div class="weather-icon">
                                                                    @{
                                                                        string weatherIconClass = weatherData.Condition switch
                                                                        {
                                                                            "Soleggiato" => "fas fa-sun", "Sereno" => "fas fa-sun",
                                                                            "Poco nuvoloso" => "fas fa-cloud-sun", "Parzialmente nuvoloso" => "fas fa-cloud-sun",
                                                                            "Nuvoloso" => "fas fa-cloud", "Coperto" => "fas fa-cloud",
                                                                            "Piovoso" => "fas fa-cloud-rain", "Pioggia debole" => "fas fa-cloud-showers-heavy",
                                                                            "Pioggia moderata" => "fas fa-cloud-rain", "Pioggia forte" => "fas fa-cloud-showers-heavy",
                                                                            "Pioviggine" => "fas fa-tint",
                                                                            "Temporale" => "fas fa-bolt", "Nevoso" => "fas fa-snowflake",
                                                                            "Neve debole" => "fas fa-snowflake", "Nebbioso" => "fas fa-smog", "Foschia" => "fas fa-smog",
                                                                            _ => "fas fa-question-circle"
                                                                        };
                                                                    }
                                                                    <i class="@weatherIconClass"></i>
                                                                </div>
                                                                <div class="weather-details">
                                                                    <span class="temperature">@weatherData.Temperature°C</span>
                                                                    <span class="condition">@weatherData.Condition</span>
                                                                </div>
                                                            </div>
                                                        }
                                                        @if(!string.IsNullOrEmpty(visit.Description))
                                                        {
                                                            <p class="visit-notes">@visit.Description</p>
                                                        }
                                                    </div>
                                                    
                                                    <div class="event-actions">
                                                        <a href="/Globe?highlightCity=@visit.CityId&lat=@visit.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)&lng=@visit.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="btn btn-neo-primary hover-float">
                                                            <i class="fas fa-globe"></i>
                                                            <span>Visualizza sul globo</span>
                                                        </a>
                                                        <button type="button" class="btn btn-neo-secondary hover-float" data-bs-toggle="modal" data-bs-target="#visitModal_@modalIdSuffix">
                                                            <i class="fas fa-edit"></i>
                                                            <span>Modifica</span>
                                                        </button>
                                                        <button type="button" class="btn btn-circle memory-btn" title="Aggiungi ricordo" data-visit-record-id="@modalIdSuffix">
                                                            <i class="fas fa-camera"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            
            <div class="journey-progress">
                <div class="journey-indicator">
                    <div class="compass-rose">
                        <div class="compass-face">
                            <div class="compass-needle"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal dialogs for editing visits -->
@foreach (var yearGroup in Model.GroupedVisits)
{
    @foreach (var visit in yearGroup.Value.Where(v => !string.IsNullOrEmpty(v.CityName)))
    {
        var modalIdSuffix = $"{visit.VisitedCityRecordId}"; // Use the unique PK from VisitedCityViewModel
        <div class="modal fade custom-modal" id="visitModal_@modalIdSuffix" tabindex="-1" aria-labelledby="visitModalLabel_@modalIdSuffix" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content glass-effect">
                    <div class="modal-header">
                        <h5 class="modal-title" id="visitModalLabel_@modalIdSuffix">Modifica Visita - @visit.CityName</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="city-info">
                            <div class="city-image">
                                <img src="/images/flags/@(visit.CountryCode?.ToLower()).png" alt="@visit.CountryName"
                                     onerror="this.onerror=null; this.src='/images/flags/unknown.png';">
                            </div>
                            <div class="city-details">
                                <h6>@visit.CityName</h6>
                                <p>@visit.CountryName</p>
                            </div>
                        </div>
                        <form method="post" asp-page-handler="EditVisit">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="visitedCityRecordId" value="@visit.VisitedCityRecordId" />
                            @* CityId might still be useful for context or if your edit handler needs it separately *@
                            <input type="hidden" name="cityIdForContext" value="@visit.CityId" /> 
                            <div class="mb-3">
                                <label for="visitDate_@modalIdSuffix" class="form-label">
                                    <i class="fas fa-calendar-alt me-2"></i> Data della visita
                                </label>
                                <div class="date-input-wrapper">
                                    <input type="date" class="form-control neo-input" id="visitDate_@modalIdSuffix" 
                                           name="visitDate" value="@visit.VisitDate.ToString("yyyy-MM-dd")" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="visitNotes_@modalIdSuffix" class="form-label">
                                    <i class="fas fa-comment-alt me-2"></i> Note sul viaggio
                                </label>
                                <textarea class="form-control neo-input" id="visitNotes_@modalIdSuffix" 
                                          name="visitNotes" rows="4">@visit.Description</textarea>
                            </div>
                            <div class="memory-gallery">
                                <h6 class="gallery-title"><i class="fas fa-images me-2"></i> Ricordi</h6>
                                <div class="memory-photos" id="memoryPhotos_@modalIdSuffix">
                                    @* Photos are best loaded dynamically by JavaScript after modal shows, using data-visit-record-id *@
                                    @* Example if pre-loading (less ideal for many photos): *@
                                    @*
                                    @foreach (var photo in Model.GetPhotosForVisitedCity(visit.VisitedCityRecordId))
                                    {
                                        <div class="memory-photo" data-photo-id="@photo.Id">
                                            <img src="@photo.Url" alt="@photo.Caption" onclick="openPhotoGallery('@modalIdSuffix', '@photo.Id')" />
                                            <button type="button" class="photo-delete-btn" data-photo-id="@photo.Id" title="Elimina foto">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    }
                                    *@
                                    <div class="add-photo" title="Aggiungi foto" data-visit-record-id="@modalIdSuffix">
                                        <i class="fas fa-plus"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-link" data-bs-dismiss="modal">Annulla</button>
                                <button type="submit" class="btn btn-primary">Salva modifiche</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}

<!-- Gallery Modal -->
<div class="modal fade" id="galleryModal" tabindex="-1" aria-labelledby="galleryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="galleryModalLabel">Galleria Fotografica</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
      </div>
      <div class="modal-body p-0">
        <div id="galleryCarousel" class="carousel slide" data-bs-ride="false">
          <div class="carousel-inner">
            <!-- Photos will be loaded dynamically -->
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#galleryCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Precedente</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#galleryCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Successivo</span>
          </button>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
      </div>
    </div>
  </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css">
    <link rel="stylesheet" href="~/css/timeline.css" asp-append-version="true" />
    <style>
        .highlight-event .event-card {
            box-shadow: 0 0 15px 5px var(--neo-primary-glow, #00aaff);
            transform: scale(1.02);
            transition: transform 0.3s ease-out, box-shadow 0.3s ease-out;
        }
        .empty-year-message {
            padding: 20px;
            text-align: center;
            background-color: rgba(30, 30, 50, 0.7); 
            border-radius: 8px;
            margin: 20px auto;
            color: #e0e0e0;
            border: 1px solid rgba(255, 255, 255, 0.2);
            max-width: 80%;
        }
        .animated-section, .animated-element {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }
        .animated-section.in-view, .animated-element.in-view {
            opacity: 1;
            transform: translateY(0);
        }
        .highlight-section {
            box-shadow: 0 0 10px 3px gold;
            border-radius: 5px;
            transition: box-shadow 0.5s ease-in-out;
        }
        .memory-photos {
            display: flex;
            flex-wrap: wrap;
            gap: 10px; /* Spacing between photos */
            margin-top: 10px;
            padding-bottom: 10px; /* Space for the add button */
        }
        .memory-photo {
            position: relative;
            width: 80px; 
            height: 80px; 
            /* margin: 5px; */ /* Handled by gap in parent */
            display: inline-block;
            border-radius: 4px;
            overflow: hidden;
            border: 1px solid #444;
            cursor: pointer; /* Indicate clickable for gallery */
        }
        .memory-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .loading-overlay, .success-indicator {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba(0,0,0,0.5);
            color: white;
            font-size: 1.5rem;
            border-radius: 4px; /* Match photo container */
        }
        .success-indicator {
            background-color: rgba(0,128,0,0.5);
            opacity: 1;
            transition: opacity 0.3s ease-out;
        }
        .photo-delete-btn {
            position: absolute;
            top: 3px;
            right: 3px;
            background-color: rgba(255,0,0,0.6);
            color: white;
            border: none;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 0.7rem;
            line-height: 20px; /* Center icon */
            text-align: center;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
            z-index: 10;
        }
        .memory-photo:hover .photo-delete-btn {
            opacity: 1;
        }
        .upload-error .loading-overlay {
             background-color: rgba(255,0,0,0.5);
        }
         .visit-notes {
            font-size: 0.9em;
            color: #bbb; 
            margin-top: 8px;
            white-space: pre-wrap; 
            max-height: 100px; /* Example */
            overflow-y: auto;
            background-color: rgba(0,0,0,0.1);
            padding: 5px;
            border-radius: 3px;
        }
        .add-photo {
            width: 80px;
            height: 80px;
            border: 2px dashed #555;
            display: inline-flex; 
            align-items: center;
            justify-content: center;
            color: #777;
            font-size: 1.5rem;
            cursor: pointer;
            border-radius: 4px;
            /* margin: 5px; */ /* Handled by gap in parent */
            vertical-align: top; 
        }
        .add-photo:hover {
            border-color: #888;
            color: #999;
        }

        /* Styles from your previous version of Timeline.cshtml, if needed */
        /* Ensure your existing timeline.css is comprehensive */
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            AOS.init({
                duration: 800,
                offset: 100,
                once: false, 
                mirror: true, 
                easing: 'ease-out-cubic'
            });
            
            createStars();
            
            setTimeout(() => {
                const firstYearTab = document.querySelector('.year-tab');
                if (firstYearTab) {
                    firstYearTab.classList.add('active');
                }
                animateSections(); 
                initializePhotoFunctionality(); // Consolidated initialization
            }, 500);
            
            document.querySelectorAll('.event-card').forEach(card => {
                card.addEventListener('mousemove', handleGlareEffect);
                card.addEventListener('mouseleave', function(e) {
                    const glare = this.querySelector('.card-glare');
                    if (glare) glare.style.opacity = "0";
                });
            });
            
            window.addEventListener('scroll', handleFlyingPlane);
            window.addEventListener('scroll', scrollSpyYearTabs); 
            
            document.querySelectorAll('.year-tab').forEach(tab => {
                tab.addEventListener('click', function(e) {
                    e.preventDefault();
                    document.querySelectorAll('.year-tab').forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    const year = this.getAttribute('data-year');
                    scrollToYear(year);
                });
            });
            
            document.querySelectorAll('.filter-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();
                    document.querySelectorAll('.filter-option').forEach(o => o.classList.remove('active'));
                    this.classList.add('active');
                    const filter = this.getAttribute('data-filter');
                    filterEvents(filter);
                    const dropdownButton = document.getElementById('filterDropdown');
                    if (dropdownButton) {
                        const iconHtml = this.querySelector('i')?.outerHTML || '';
                        dropdownButton.innerHTML = `${iconHtml} ${this.textContent.trim()}`;
                    }
                });
            });
            
            document.querySelectorAll('.dropdown').forEach(dropdown => {
                dropdown.addEventListener('shown.bs.dropdown', function () { /* Popper.js handles positioning */ });
            });

            document.querySelectorAll('.sort-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();
                    document.querySelectorAll('.sort-option').forEach(o => o.classList.remove('active'));
                    this.classList.add('active');
                    const sort = this.getAttribute('data-sort');
                    sortEvents(sort);
                    const dropdownButton = document.getElementById('sortDropdown');
                    if (dropdownButton) {
                         const iconHtml = this.querySelector('i')?.outerHTML || '';
                        dropdownButton.innerHTML = `${iconHtml} ${this.textContent.trim()}`;
                    }
                });
            });
            
            const progressIndicator = document.querySelector('.journey-indicator');
            if (progressIndicator) {
                progressIndicator.addEventListener('click', function() {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }
            
            highlightFromUrl();

            document.querySelectorAll('.memory-btn').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const modalTargetId = this.closest('.timeline-event').querySelector('button[data-bs-target^="#visitModal_"]').getAttribute('data-bs-target');
                    const visitModalElement = document.querySelector(modalTargetId);
                    if (visitModalElement) {
                        const visitModal = new bootstrap.Modal(visitModalElement);
                        visitModal.show();
                        
                        const visitedCityRecordId = this.dataset.visitRecordId; // Get the unique visit ID
                        loadPhotosForModal(visitedCityRecordId); // Load photos when modal is shown

                        setTimeout(() => {
                            const photoSection = visitModalElement.querySelector('.memory-gallery');
                            if (photoSection) {
                                photoSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                photoSection.classList.add('highlight-section');
                                setTimeout(() => {
                                    photoSection.classList.remove('highlight-section');
                                }, 2000);
                            }
                        }, 300); 
                    }
                });
            });
        }); 
        
        function initializePhotoFunctionality() {
            // Initialize "Add Photo" buttons inside modals
            document.querySelectorAll('.add-photo').forEach(addPhotoBtn => {
                addPhotoBtn.addEventListener('click', handleAddPhotoClick);
            });

            // Initialize delete buttons for any photos that might be pre-rendered by Razor
            document.querySelectorAll('.memory-photo .photo-delete-btn').forEach(btn => {
                btn.addEventListener('click', handleDeletePhotoClick);
            });

            // Initialize click-to-open-gallery for pre-rendered photos
             document.querySelectorAll('.memory-photo img').forEach(img => {
                const photoContainer = img.closest('.memory-photo');
                const photoId = photoContainer.dataset.photoId;
                const visitRecordId = photoContainer.closest('.memory-photos').querySelector('.add-photo').dataset.visitRecordId;
                if (photoId && visitRecordId) {
                    addGalleryClickHandler(img, visitRecordId, photoId);
                }
            });
        }
        
        function handleAddPhotoClick() {
            const addPhotoBtn = this; // 'this' is the clicked .add-photo button
            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.name = 'photoFile'; 
            fileInput.accept = 'image/*';
            fileInput.style.display = 'none';
            document.body.appendChild(fileInput);
            fileInput.click();
            
            fileInput.addEventListener('change', function() {
                if (this.files && this.files[0]) {
                    const file = this.files[0];
                    const visitRecordId = addPhotoBtn.dataset.visitRecordId; // Get from the button itself
                    if (!visitRecordId) {
                        console.error('Visit Record ID (data-visit-record-id) not found on add-photo button.');
                        if(fileInput.parentNode) document.body.removeChild(fileInput);
                        return;
                    }
                    
                    const formData = new FormData();
                    formData.append('photoFile', file); 
                    formData.append('visitedCityRecordId', visitRecordId); 
                    
                    const photoPreviewContainer = document.createElement('div');
                    photoPreviewContainer.className = 'memory-photo';
                    const img = document.createElement('img');
                    const reader = new FileReader();
                    reader.onload = e => { img.src = e.target.result; };
                    reader.readAsDataURL(file);
                    photoPreviewContainer.appendChild(img);
                    
                    const loadingOverlay = document.createElement('div');
                    loadingOverlay.className = 'loading-overlay';
                    loadingOverlay.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>';
                    photoPreviewContainer.appendChild(loadingOverlay);
                    
                    const memoryPhotosContainer = addPhotoBtn.closest('.memory-photos');
                    memoryPhotosContainer.insertBefore(photoPreviewContainer, addPhotoBtn);
                    
                    const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    fetch('?handler=UploadPhoto', { 
                        method: 'POST',
                        body: formData,
                        headers: { 'RequestVerificationToken': csrfToken || '' }
                    })
                    .then(response => response.ok ? response.json() : response.text().then(text => { throw new Error('Upload failed: ' + text); }))
                    .then(data => {
                        loadingOverlay.remove();
                        if (data.success && data.photoId && data.photoUrl) {
                            img.src = data.photoUrl; 
                            photoPreviewContainer.dataset.photoId = data.photoId;
                            addSuccessIndicator(photoPreviewContainer);
                            addDeleteButtonToPhoto(photoPreviewContainer, data.photoId, visitRecordId);
                            addGalleryClickHandler(img, visitRecordId, data.photoId);
                        } else { throw new Error(data.message || "Upload failed, no specific error message from server."); }
                    })
                    .catch(error => handleError(error, photoPreviewContainer, loadingOverlay))
                    .finally(() => { if(fileInput.parentNode) document.body.removeChild(fileInput); });
                } else { if(fileInput.parentNode) document.body.removeChild(fileInput); }
            });
            fileInput.oncancel = () => { if (fileInput.parentNode) document.body.removeChild(fileInput); };
        }

        function handleDeletePhotoClick() {
            const photoId = this.dataset.photoId;
            const photoElement = this.closest('.memory-photo');
            const visitRecordId = photoElement.closest('.memory-photos').querySelector('.add-photo').dataset.visitRecordId;
            deletePhoto(photoId, photoElement, visitRecordId);
        }

        function addSuccessIndicator(container) { /* ... (same as before) ... */ }
        function addDeleteButtonToPhoto(container, photoId, visitRecordId) { /* ... (same as before, ensure event listener is added) ... */ 
            const deleteBtn = document.createElement('button');
            deleteBtn.type = 'button';
            deleteBtn.className = 'photo-delete-btn';
            deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
            deleteBtn.title = 'Elimina foto';
            deleteBtn.dataset.photoId = photoId;
            container.appendChild(deleteBtn);
            deleteBtn.addEventListener('click', handleDeletePhotoClick); // Make sure this calls the correct handler
        }
        function addGalleryClickHandler(imgElement, visitRecordId, photoId) { /* ... (same as before) ... */ }
        function handleError(error, photoPreviewContainer, loadingOverlay) { /* ... (same as before) ... */ }
        function createStars() { /* ... (same as before) ... */ }
        function deletePhoto(photoId, elementToRemove, visitRecordIdForRefresh) { /* ... (same as before) ... */ }
        function openPhotoGallery(visitRecordId, activePhotoId = null) { /* ... (same as before, ensure handler is correct) ... */ }
        function handleGlareEffect(e) { /* ... (same as before) ... */ }
        function handleFlyingPlane() { /* ... (same as before) ... */ }
        function scrollToYear(year) { /* ... (same as before) ... */ }
        function filterEvents(filter) { /* ... (same as before) ... */ }
        function sortEvents(sortOrder) { /* ... (same as before) ... */ }
        function animateSections() { /* ... (same as before) ... */ }
        function highlightFromUrl() { /* ... (same as before) ... */ }
        function scrollSpyYearTabs() { /* ... (same as before) ... */ }

        async function loadPhotosForModal(visitedCityRecordId) {
            const memoryPhotosContainer = document.getElementById(`memoryPhotos_${visitedCityRecordId}`);
            if (!memoryPhotosContainer) {
                console.warn(`Memory photos container not found for visit ${visitedCityRecordId}`);
                return;
            }

            const addPhotoBtn = memoryPhotosContainer.querySelector('.add-photo'); 
            memoryPhotosContainer.querySelectorAll('.memory-photo').forEach(el => el.remove());

            try {
                const response = await fetch(`?handler=VisitPhotos&visitedCityRecordId=${visitedCityRecordId}`);
                if (!response.ok) throw new Error(`Failed to load photos: ${response.statusText}`);
                const photos = await response.json();

                if (photos && photos.length > 0) {
                    photos.forEach(photo => {
                        const photoDiv = document.createElement('div');
                        photoDiv.className = 'memory-photo';
                        photoDiv.dataset.photoId = photo.id;
                        
                        const img = document.createElement('img');
                        img.src = photo.url;
                        img.alt = photo.caption || 'Ricordo di viaggio';
                        addGalleryClickHandler(img, visitedCityRecordId, photo.id);
                        photoDiv.appendChild(img);
                        
                        addDeleteButtonToPhoto(photoDiv, photo.id, visitedCityRecordId);
                        if (addPhotoBtn) { // Insert before the add button
                            memoryPhotosContainer.insertBefore(photoDiv, addPhotoBtn);
                        } else { // Or just append if add button isn't there (should be)
                            memoryPhotosContainer.appendChild(photoDiv);
                        }
                    });
                } else if (addPhotoBtn) {
                    // Ensure add button is still there if no photos
                    if (!memoryPhotosContainer.contains(addPhotoBtn)) {
                         memoryPhotosContainer.appendChild(addPhotoBtn);
                    }
                }
            } catch (error) {
                console.error(`Error loading photos for modal visit ${visitedCityRecordId}:`, error);
            }
        }

    </script>
}

@functions {
    string GetContinentIcon(string continent) {
        if (string.IsNullOrEmpty(continent)) return "fas fa-globe"; 
        
        switch (continent.Trim().ToLowerInvariant()) {
            case "europa": return "fas fa-landmark"; 
            case "asia": return "fas fa-torii-gate"; 
            case "africa": return "fas fa-mountain-sun"; 
            case "nord america": case "north america": return "fas fa-monument"; 
            case "sud america": case "south america": return "fas fa-tree-palm"; 
            case "oceania": return "fas fa-water"; 
            case "antartide": case "antarctica": return "fas fa-snowflake"; 
            default: return "fas fa-globe"; 
        }
    }
}