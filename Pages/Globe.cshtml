        .globe-legend {
            position: absolute;
            bottom: 20px;
            right: 20px;
            z-index: 100;
            background-color: rgba(0,0,0,0.6); /* Darker for better contrast */
            padding: 10px 15px;
            border-radius: 8px;
            color: white;
            font-size: 0.85rem;
        }

        .legend-item {
            display: flex;
            align-items: center;
            margin-bottom: 5px;
        }

            .legend-item:last-child {
                margin-bottom: 0;
            }

        .legend-marker {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-right: 8px;
            flex-shrink: 0;
        }

            .legend-marker.visited {
                background-color: #ff4757; /* Example color */
            }

            .legend-marker.next {
                background-color: #2ecc71; /* Example color */
            }

        /* Responsive */
        @@media (max-width: 992px) { /* Adjust breakpoint as needed */
            .globe-container {
                grid-template-columns: 1fr; /* Stack sidebar and globe */
                /* Set a fixed height for sidebar when stacked or let it take content height */
                grid-template-rows: auto 1fr; /* Sidebar auto, globe takes rest */
            }

            .main-globe-container {
                order: 1; /* Globe first visually if preferred */
                min-height: 300px; /* Ensure globe has some height */
            }

            .explorer-sidebar {
                order: 2;
                height: auto; /* Adjust height as needed, or make it scrollable */
                max-height: 50vh; /* Example: limit height and make tab-content scroll */
                border-right: none;
                border-bottom: 1px solid rgba(0,0,0,0.1);
            }

            .visited-cities-grid { /* Adjust for smaller screens */
                grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
