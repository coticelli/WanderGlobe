        }

        @@media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: 1fr; /* Stack stat items */
            }

            .profile-info {
                flex-direction: column;
                align-items: flex-start;
            }

            .nav-tabs .nav-link .tab-text { /* Optionally hide text on very small screens */
                /* display: none; */
            }

            .nav-tabs .nav-link i {
                /* margin-right: 0; */
            }
        }

        /* Stili per i popup dei marker (dal file globe-popup.css) */
        .country-popup {
            position: absolute !important;
            width: 300px;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            z-index: 2000;
            animation: popup-fade-in 0.3s ease;
            pointer-events: auto; /* Crucial for interaction */
            transform: none !important; /* Override any external transforms */
        }

        @@keyframes popup-fade-in {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .pin-button { /* Style for pin button inside popup */
            transition: transform 0.3s ease, color 0.3s ease;
        }

            .pin-button:hover {
                background-color: rgba(0,0,0,0.05);
            }

        .country-popup[data-pinned="true"] .pin-button {
            color: var(--primary-color); /* Use theme color for pinned state */
            transform: rotate(-45deg);
        }

        .country-popup[data-pinned="true"] {
            box-shadow: 0 5px 25px rgba(var(--primary-color-rgb, 26, 115, 232), 0.4); /* Use theme color shadow */
        }
    </style>
}

    @section Scripts {
    <!-- Three.js library -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.132.2/build/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.132.2/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.4/gsap.min.js"></script>
    <script>
        // DOMContentLoaded ensures all HTML is parsed before scripts run
        document.addEventListener('DOMContentLoaded', function () {

            // Search city functionality
            const searchCityInput = document.getElementById('searchCity');
            if (searchCityInput) {
                searchCityInput.addEventListener('input', filterListedCities);
            }

            // City preview in "Add City" tab
            const cityIdDropdown = document.getElementById('cityId');
            if (cityIdDropdown) {
                cityIdDropdown.addEventListener('change', updateCityPreview);
            }

            // "Fly to" button functionality
            document.querySelectorAll('.fly-to-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const lat = parseFloat(this.getAttribute('data-lat'));
                    const lng = parseFloat(this.getAttribute('data-lng'));
                    if (!isNaN(lat) && !isNaN(lng) && typeof flyToLocation === 'function') {
                        flyToLocation(lat, lng);
                    }
                });
            });

            // Initialize Globe and its controls
            if (typeof initGlobe === 'function') initGlobe();
            if (typeof setupGlobeControls === 'function') setupGlobeControls();
        });

        function filterListedCities() {
            const searchTerm = document.getElementById('searchCity').value.toLowerCase();
            const cityCards = document.querySelectorAll('#citiesList .city-card');
            let visibleCount = 0;

            cityCards.forEach(card => {
                const cityName = card.dataset.name || "";
                const countryName = card.dataset.country || "";
                // const continentName = card.dataset.continent || ""; // Optionally search by continent

                if (cityName.includes(searchTerm) || countryName.includes(searchTerm)) {
                    card.style.display = '';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Handle "no results" message
            const citiesListContainer = document.getElementById('citiesList');
            let noResultsEl = document.getElementById('noResultsMessage');
            if (visibleCount === 0 && searchTerm.length > 0 && citiesListContainer) {
                if (!noResultsEl) {
                    noResultsEl = document.createElement('div');
                    noResultsEl.id = 'noResultsMessage';
                    noResultsEl.className = 'text-center py-4 text-muted';
                    citiesListContainer.appendChild(noResultsEl);
                }
                noResultsEl.innerHTML = `<p>Nessuna città trovata per "${searchTerm}"</p>`;
            } else if (noResultsEl) {
                noResultsEl.remove();
            }
        }

        function updateCityPreview() {
            const cityPreviewDiv = document.getElementById('cityPreview');
            const selectedOption = this.options[this.selectedIndex];

            if (this.value && cityPreviewDiv) {
                const cityInfoText = selectedOption.text;
                const parts = cityInfoText.match(/(.+)\s\((.+)\)/);
                const cityName = parts ? parts[1] : cityInfoText;
                const countryName = parts ? parts[2] : "";

                document.getElementById('previewCityName').textContent = cityName;
                document.getElementById('previewCountryName').textContent = countryName;

                const countryCode = selectedOption.getAttribute('data-country-code') || 'unknown';
                const cityImageEl = document.getElementById('cityImage');
                if (cityImageEl) {
                    cityImageEl.src = `/images/cities/${countryCode.toLowerCase()}-city.jpg`;
                    // onerror is already in HTML
                }
                cityPreviewDiv.style.display = 'flex';
            } else if (cityPreviewDiv) {
                cityPreviewDiv.style.display = 'none';
            }
        }

    </script>
    <script>
        // Visited pins data from backend
        window.visitedPins = @Html.Raw(Model.VisitedCountriesJson ?? "[]");

        console.log("Pin caricati (VisitedCityViewModel):", window.visitedPins ? window.visitedPins.length : 0, window.visitedPins);

        document.addEventListener('DOMContentLoaded', function () {
            if (window.visitedPins && window.visitedPins.length > 0) {
                console.log(`Numero di pin (window.visitedPins): ${window.visitedPins.length}`);
                window.visitedPins.forEach((pin, index) => {
                    console.log(`Pin ${index}: ${pin.CityName} (${pin.CountryName}, ${pin.Continent}), Lat: ${pin.Latitude}, Lng: ${pin.Longitude}`);
                });
            } else {
                console.warn("Nessun pin trovato nella variabile window.visitedPins all'interno del DOMContentLoaded.");
            }
        });
    </script>

    <script>
        // Data transformation for map markers
        const visitedMapMarkers = (window.visitedPins || []).map(pin => {
            return {
                name: pin.CityName,
                countryName: pin.CountryName,
                countryCode: pin.CountryCode,
                continent: pin.Continent,
                lat: pin.Latitude,
                lng: pin.Longitude,
                visitDate: new Date(pin.VisitDate).toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' })
            };
        });
        console.log("Processed visitedMapMarkers for globe:", visitedMapMarkers);

        // Three.js Globe Initialization and Functions
        let camera, scene, renderer, controls, earth, clouds, atmosphere;
        const markersGroup = new THREE.Group(); // Define globally for access

        function initGlobe() {
            const container = document.getElementById('globe-container');
            if (!container) {
                console.error("Globe container not found!");
                return;
            }

            scene = new THREE.Scene();
            scene.add(markersGroup); // Add markers group to scene

            camera = new THREE.PerspectiveCamera(60, container.offsetWidth / container.offsetHeight, 0.1, 1000);
            camera.position.set(0, 5, 13); // Slightly elevated view

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(container.offsetWidth, container.offsetHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            // renderer.setClearColor(0x000000, 0); // Transparent background
            container.innerHTML = ''; // Clear container before appending canvas
            container.appendChild(renderer.domElement);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.5); // Softer ambient
            scene.add(ambientLight);
            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(5, 10, 7);
            scene.add(directionalLight);

            const textureLoader = new THREE.TextureLoader();
            textureLoader.crossOrigin = 'anonymous';

            // Starfield
            const stars = createStarfield(100); // Increased radius
            scene.add(stars);

            // Earth
            const earthGeometry = new THREE.SphereGeometry(5, 64, 64);
            const earthMaterial = new THREE.MeshPhongMaterial({
                map: textureLoader.load('https://cdn.jsdelivr.net/gh/turban/webgl-earth@master/images/2_no_clouds_4k.jpg', undefined, handleTextureError),
                bumpMap: textureLoader.load('https://cdn.jsdelivr.net/gh/turban/webgl-earth@master/images/elev_bump_4k.jpg', undefined, handleTextureError),
                bumpScale: 0.01, // Slightly more pronounced bump
                specularMap: textureLoader.load('https://cdn.jsdelivr.net/gh/turban/webgl-earth@master/images/water_4k.png', undefined, handleTextureError),
                specular: new THREE.Color(0x333333), // Tuned specular
                shininess: 10
            });
            earth = new THREE.Mesh(earthGeometry, earthMaterial);
            earth.rotation.y = Math.PI; // Align texture
            scene.add(earth);

            // Clouds
            const cloudsGeometry = new THREE.SphereGeometry(5.03, 64, 64); // Closer to surface
            const cloudsMaterial = new THREE.MeshPhongMaterial({
                map: textureLoader.load('https://cdn.jsdelivr.net/gh/turban/webgl-earth@master/images/fair_clouds_4k.png', undefined, handleTextureError),
                transparent: true,
                opacity: 0.3, // Slightly more transparent
                blending: THREE.AdditiveBlending // Softer blending
            });
            clouds = new THREE.Mesh(cloudsGeometry, cloudsMaterial);
            clouds.rotation.y = Math.PI;
            scene.add(clouds);

            // Atmosphere Glow (ShaderMaterial)
            const atmosphereGeometry = new THREE.SphereGeometry(5.2, 64, 64); // Adjusted radius
            const atmosphereShaderMaterial = new THREE.ShaderMaterial({
                uniforms: {
                    "c": { value: 0.5 }, // Fresnel coefficient
                    "p": { value: 4.0 }, // Fresnel power
                    glowColor: { value: new THREE.Color(0x5897d4) }, // Glow color (more blue)
                },
                vertexShader: `
                            varying vec3 vNormal;
                            void main() {
                                vNormal = normalize( normalMatrix * normal );
                                gl_Position = projectionMatrix * modelViewMatrix * vec4( position, 1.0 );
                            }`,
                fragmentShader: `
                            uniform vec3 glowColor;
                            uniform float c;
                            uniform float p;
                            varying vec3 vNormal;
                            void main() {
                                float intensity = pow( c - dot( vNormal, vec3( 0.0, 0.0, 1.0 ) ), p );
                                gl_FragColor = vec4( glowColor, intensity * 0.8 ); // Adjusted intensity and alpha
                            }`,
                side: THREE.BackSide,
                blending: THREE.AdditiveBlending,
                transparent: true,
                depthWrite: false // Important for transparency
            });
            atmosphere = new THREE.Mesh(atmosphereGeometry, atmosphereShaderMaterial);
            scene.add(atmosphere);

            // Add Markers
            visitedMapMarkers.forEach((pinData, index) => {
                addGlobeMarker(pinData, index, markersGroup);
            });

            // Controls
            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.minDistance = 6.5; // Zoom limits
            controls.maxDistance = 25;
            controls.autoRotate = true;
            controls.autoRotateSpeed = 0.15; // Slower auto-rotate
            controls.target.set(0, 0, 0); // Ensure target is center

            // Raycasting for marker interaction
            const raycaster = new THREE.Raycaster();
            const mouse = new THREE.Vector2();
            let activeMarkerGroup = null; // Stores the THREE.Group of the active marker
            let popupIsPinned = false;
            let popupCloseTimer = null;

            renderer.domElement.addEventListener('mousemove', (event) => {
                const rect = renderer.domElement.getBoundingClientRect();
                mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
                mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

                raycaster.setFromCamera(mouse, camera);
                const intersects = raycaster.intersectObjects(markersGroup.children, true); // true for recursive
                const markerHit = intersects.find(hit => hit.object.userData.isMarkerMesh);

                if (markerHit) {
                    const markerGroup = markerHit.object.parent; // The THREE.Group
                    renderer.domElement.style.cursor = 'pointer';
                    if (controls.autoRotate) {
                        controls._wasAutoRotating = true; // Store state
                        controls.autoRotate = false;
                    }
                    if (activeMarkerGroup !== markerGroup && !popupIsPinned) {
                        if (activeMarkerGroup) gsap.to(activeMarkerGroup.scale, { x: 1, y: 1, z: 1, duration: 0.2 });
                        activeMarkerGroup = markerGroup;
                        gsap.to(activeMarkerGroup.scale, { x: 1.5, y: 1.5, z: 1.5, duration: 0.2 });
                        showGlobePopup(activeMarkerGroup, event.clientX, event.clientY);
                    }
                } else {
                    renderer.domElement.style.cursor = 'default';
                    if (activeMarkerGroup && !isMouseOverPopup(event) && !popupIsPinned) {
                        if (popupCloseTimer) clearTimeout(popupCloseTimer);
                        popupCloseTimer = setTimeout(() => {
                            gsap.to(activeMarkerGroup.scale, { x: 1, y: 1, z: 1, duration: 0.2 });
                            hideAllGlobePopups();
                            activeMarkerGroup = null;
                            if (controls._wasAutoRotating) controls.autoRotate = true;
                            popupCloseTimer = null;
                        }, 200); // Shorter delay
                    }
                }
            });

            renderer.domElement.addEventListener('click', (event) => {
                raycaster.setFromCamera(mouse, camera);
                const intersects = raycaster.intersectObjects(markersGroup.children, true);
                const markerHit = intersects.find(hit => hit.object.userData.isMarkerMesh);

                if (markerHit) {
                    const markerGroup = markerHit.object.parent;
                    const popupId = markerGroup.userData.popupId;
                    const popup = document.getElementById(popupId);

                    if (popup && popup.style.display === 'block') {
                        popupIsPinned = !popupIsPinned;
                        popup.dataset.pinned = popupIsPinned ? "true" : "false";
                        const pinButton = popup.querySelector('.pin-button');
                        if (pinButton) {
                            pinButton.style.transform = popupIsPinned ? 'rotate(-45deg)' : 'rotate(0)';
                            pinButton.style.color = popupIsPinned ? 'var(--primary-color)' : '#999';
                        }
                        if (!popupIsPinned && controls._wasAutoRotating) controls.autoRotate = true;
                    } else {
                        // If popup wasn't shown, show and pin it (or just show if you prefer)
                        showGlobePopup(markerGroup, event.clientX, event.clientY);
                        // You might want to auto-pin on click or have separate logic
                    }
                } else { // Clicked on globe, not a marker
                    if (!popupIsPinned) {
                        hideAllGlobePopups();
                        if (activeMarkerGroup) {
                            gsap.to(activeMarkerGroup.scale, { x: 1, y: 1, z: 1, duration: 0.2 });
                            activeMarkerGroup = null;
                        }
                        if (controls._wasAutoRotating) controls.autoRotate = true;
                    }
                }
            });

            function showGlobePopup(markerGroup, mouseX, mouseY) {
                if (popupCloseTimer) clearTimeout(popupCloseTimer);
                if (!popupIsPinned) hideAllGlobePopups();

                const popupId = markerGroup.userData.popupId;
                const popup = document.getElementById(popupId);
                if (!popup) return;

                popup.dataset.pinned = popupIsPinned ? "true" : "false";

                const { name, country, countryCode, visitDate, index } = markerGroup.userData;
                popup.innerHTML = `
                            <div style="padding: 12px; background-color: #fff; border-bottom: 1px solid #eee; display: flex; align-items: center; position: relative;">
                                <img src="/images/cities/${countryCode?.toLowerCase()}-city.jpg" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" alt="${name}" style="width: 50px; height: 50px; border-radius: 4px; object-fit: cover; margin-right: 10px;">
                                <img src="/images/city-placeholder.jpg" alt="Placeholder" style="width: 50px; height: 50px; border-radius: 4px; object-fit: cover; margin-right: 10px; display:none;">
                                <div style="flex-grow: 1;">
                                    <h6 style="margin: 0; font-size: 1rem; color: #333; font-weight: 600;">${name}</h6>
                                    <p style="margin: 2px 0 0; font-size: 0.8rem; color: #666;">${country}</p>
                                    <span style="font-size: 0.75rem; color: #888; display: block; margin-top: 3px;">${visitDate}</span>
                                </div>
                                <button class="pin-button" title="Fissa/Sgancia popup" style="position: absolute; top: 8px; right: 34px; background: none; border: none; font-size: 1rem; color: ${popupIsPinned ? 'var(--primary-color)' : '#999'}; transform: ${popupIsPinned ? 'rotate(-45deg)' : 'rotate(0)'}; cursor: pointer; padding: 5px; border-radius: 50%;"><i class="fas fa-thumbtack"></i></button>
                                <button class="popup-close" title="Chiudi" style="position: absolute; top: 8px; right: 8px; background: none; border: none; font-size: 1.2rem; color: #999; cursor: pointer; padding: 5px;">×</button>
                            </div>
                            <div style="padding: 15px;">
                                <p style="margin: 0 0 12px; font-size: 0.85rem; line-height: 1.4; color: #555;">Hai visitato ${name}!</p>
                                <div style="text-align: right;">
                                    <button class="details-button btn btn-sm btn-primary" data-index="${index}">Vedi dettagli</button>
                                </div>
                            </div>`;

                const pinBtn = popup.querySelector('.pin-button');
                if (pinBtn) pinBtn.onclick = (e) => {
                    e.stopPropagation();
                    popupIsPinned = !popupIsPinned;
                    popup.dataset.pinned = popupIsPinned;
                    pinBtn.style.transform = popupIsPinned ? 'rotate(-45deg)' : 'rotate(0)';
                    pinBtn.style.color = popupIsPinned ? 'var(--primary-color)' : '#999';
                    if (!popupIsPinned && controls._wasAutoRotating) controls.autoRotate = true;
                };
                const closeBtn = popup.querySelector('.popup-close');
                if (closeBtn) closeBtn.onclick = () => {
                    popup.style.display = 'none';
                    popupIsPinned = false;
                    if (activeMarkerGroup === markerGroup) activeMarkerGroup = null; // Clear if this was the active one
                    if (controls._wasAutoRotating) controls.autoRotate = true;
                };
                const detailsBtn = popup.querySelector('.details-button');
                if (detailsBtn) detailsBtn.onclick = () => window.location.href = `/Timeline?highlight=${markerGroup.userData.index}`;

                let x = mouseX + 20;
                let y = mouseY - popup.offsetHeight / 2; // Center vertically initially
                if (x + popup.offsetWidth > window.innerWidth) x = mouseX - popup.offsetWidth - 20;
                if (y + popup.offsetHeight > window.innerHeight) y = window.innerHeight - popup.offsetHeight - 10;
                if (y < 10) y = 10;

                popup.style.left = `${x}px`;
                popup.style.top = `${y}px`;
                popup.style.display = 'block';
                gsap.fromTo(popup, { opacity: 0, transform: 'scale(0.95)' }, { opacity: 1, transform: 'scale(1)', duration: 0.2 });
            }

            function hideAllGlobePopups() {
                if (popupIsPinned) return;
                document.querySelectorAll('.country-popup').forEach(p => {
                    if (p.dataset.pinned !== "true") p.style.display = 'none';
                });
            }

            function isMouseOverPopup(event) {
                return event.target.closest('.country-popup') !== null;
            }

            // Animation loop
            let lastCloudRotationTime = 0;
            function animate(time) {
                requestAnimationFrame(animate);
                controls.update();

                // Animate clouds slowly
                if (time - lastCloudRotationTime > 30) { // Update cloud rotation less frequently
                    clouds.rotation.y += 0.0001;
                    lastCloudRotationTime = time;
                }

                renderer.render(scene, camera);
            }
            animate(0); // Start animation

            // Handle window resize
            window.addEventListener('resize', () => {
                camera.aspect = container.offsetWidth / container.offsetHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(container.offsetWidth, container.offsetHeight);
            });
        }

        function createStarfield(radius) {
            const vertices = [];
            for (let i = 0; i < 15000; i++) { // More stars
                const x = THREE.MathUtils.randFloatSpread(radius * 2);
                const y = THREE.MathUtils.randFloatSpread(radius * 2);
                const z = THREE.MathUtils.randFloatSpread(radius * 2);
                if (new THREE.Vector3(x, y, z).length() > radius / 2) // Ensure they are far enough
                    vertices.push(x, y, z);
            }
            const geometry = new THREE.BufferGeometry();
            geometry.setAttribute('position', new THREE.Float32BufferAttribute(vertices, 3));
            const material = new THREE.PointsMaterial({ color: 0xffffff, size: 0.3, sizeAttenuation: true });
            return new THREE.Points(geometry, material);
        }

        function handleTextureError(errorSource) {
            console.error("Errore caricamento texture:", errorSource.src);
            // Return a placeholder texture (e.g., a 1x1 blue pixel)
            const canvas = document.createElement('canvas');
            canvas.width = 1; canvas.height = 1;
            const context = canvas.getContext('2d');
            context.fillStyle = '#0000FF'; // Blue
            context.fillRect(0, 0, 1, 1);
            return new THREE.CanvasTexture(canvas);
        }

        function addGlobeMarker(pinData, index, parentMarkersGroup) {
            const latRad = pinData.lat * (Math.PI / 180);
            const lonRad = -pinData.lng * (Math.PI / 180); // Negate for correct mapping
            const earthRadius = 5;

            const markerGroup = new THREE.Group();
            markerGroup.position.set(
                Math.cos(latRad) * Math.cos(lonRad) * earthRadius,
                Math.sin(latRad) * earthRadius,
                Math.cos(latRad) * Math.sin(lonRad) * earthRadius
            );
            markerGroup.lookAt(0, 0, 0); // Orient towards center initially, then adjust

            // Simple sphere marker
            const markerGeometry = new THREE.SphereGeometry(0.05, 16, 16); // Smaller marker
            const markerMaterial = new THREE.MeshPhongMaterial({ color: 0xff5733, emissive: 0xff5733, emissiveIntensity: 0.6 });
            const markerMesh = new THREE.Mesh(markerGeometry, markerMaterial);
            markerMesh.userData = { isMarkerMesh: true }; // For raycasting
            markerGroup.add(markerMesh);

            // Pulsating glow (optional, can be performance intensive with many markers)
            const glowGeometry = new THREE.SphereGeometry(0.08, 16, 16);
            const glowMaterial = new THREE.MeshBasicMaterial({ color: 0xff5733, transparent: true, opacity: 0.3 });
            const glowMesh = new THREE.Mesh(glowGeometry, glowMaterial);
            markerGroup.add(glowMesh);
            gsap.to(glowMesh.scale, { x: 1.5, y: 1.5, z: 1.5, duration: 1, repeat: -1, yoyo: true, ease: "sine.inOut" });


            markerGroup.userData = { ...pinData, index, popupId: `popup-globe-${index}` };
            parentMarkersGroup.add(markerGroup);

            // Create DOM element for popup (initially hidden)
            const popupEl = document.createElement('div');
            popupEl.id = markerGroup.userData.popupId;
            popupEl.className = 'country-popup'; // From your CSS
            popupEl.style.display = 'none';
            document.body.appendChild(popupEl);
        }

        function setupGlobeControls() {
            const zoomInBtn = document.getElementById('zoomInBtn');
            const zoomOutBtn = document.getElementById('zoomOutBtn');
            const resetViewBtn = document.getElementById('resetViewBtn');

            if (!controls) { // Check if controls are initialized
                console.warn("OrbitControls not ready for setupGlobeControls.");
                return;
            }

            if (zoomInBtn) zoomInBtn.addEventListener('click', () => { controls.dollyOut(1.2); controls.update(); });
            if (zoomOutBtn) zoomOutBtn.addEventListener('click', () => { controls.dollyIn(1.2); controls.update(); });
            if (resetViewBtn) resetViewBtn.addEventListener('click', () => {
                gsap.to(camera.position, { x: 0, y: 5, z: 13, duration: 1, onUpdate: () => camera.lookAt(0, 0, 0) });
                gsap.to(controls.target, { x: 0, y: 0, z: 0, duration: 1 });
            });
        }

        // Fly to specific coordinates on the globe
        function flyToLocation(lat, lng) {
            if (!camera || !controls || !earth) {
                console.warn("Cannot flyToLocation: Globe components not ready.");
                return;
            }

            controls.autoRotate = false;
            const latRad = lat * (Math.PI / 180);
            const lonRad = -lng * (Math.PI / 180); // Negate for correct mapping
            const targetDistance = 7.5; // How close to fly

            const targetPosition = new THREE.Vector3(
                Math.cos(latRad) * Math.cos(lonRad) * targetDistance,
                Math.sin(latRad) * targetDistance,
                Math.cos(latRad) * Math.sin(lonRad) * targetDistance
            );

            gsap.to(camera.position, {
                x: targetPosition.x,
                y: targetPosition.y,
                z: targetPosition.z,
                duration: 1.5,
                ease: "power2.inOut",
                onUpdate: () => camera.lookAt(earth.position), // Keep looking at Earth's center
                onComplete: () => {
                    // Optional: resume auto-rotate after a delay
                    // setTimeout(() => { if (controls && controls._wasAutoRotating) controls.autoRotate = true; }, 2000);
                }
            });
            // Also ensure controls target is updated if it moved
            gsap.to(controls.target, { x: 0, y: 0, z: 0, duration: 1.5, ease: "power2.inOut" });
        }
    </script>
}